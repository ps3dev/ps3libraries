+
+static const char *gai_strerror(int err)
+{
+    switch (err) {
+    case 0: return "Success";
+    case EAI_BADFLAGS: return "Invalid flags";
+    case EAI_NONAME: return "Unknown host";
+    case EAI_AGAIN: return "Temporary failure in name resolution";
+    case EAI_FAIL: return "Non-recoverable failure in name resolution";
+    case EAI_FAMILY: return "Address family not supported";
+    case EAI_MEMORY: return "Memory allocation failure";
+    case EAI_SERVICE: return "Servname not supported for ai_socktype";
+    case EAI_SOCKTYPE: return "ai_socktype not supported";
+    case EAI_SYSTEM: return "System error";
+    case EAI_OVERFLOW: return "Argument buffer overflow";
+    default: return "Unknown error";
+    }
+}
+
+static void freeaddrinfo(struct addrinfo *ai)
+{
+    while (ai) {
+        struct addrinfo *next = ai->ai_next;
+        SDL_free(ai->ai_addr);
+        SDL_free(ai->ai_canonname);
+        SDL_free(ai);
+        ai = next;
+    }
+}
+
+static int getnameinfo(const struct sockaddr *sa, socklen_t salen, char *host, socklen_t hostlen, char *serv, socklen_t servlen, int flags)
+{
+    (void) salen;
+    (void) flags;
+    if (!sa) {
+        return EAI_FAIL;
+    }
+    if (sa->sa_family != AF_INET) {
+        return EAI_FAMILY;
+    }
+    const struct sockaddr_in *sin = (const struct sockaddr_in *) sa;
+    if (host && hostlen > 0) {
+        if (!inet_ntop(AF_INET, &sin->sin_addr, host, hostlen)) {
+            return EAI_OVERFLOW;
+        }
+    }
+    if (serv && servlen > 0) {
+        SDL_snprintf(serv, servlen, "%u", (unsigned int) ntohs(sin->sin_port));
+    }
+    return 0;
+}
+
+static struct addrinfo *PS3AllocAddrInfo(int socktype, int protocol, const struct sockaddr_in *sin)
+{
+    struct addrinfo *ai = (struct addrinfo *) SDL_calloc(1, sizeof (*ai));
+    struct sockaddr_in *addr = (struct sockaddr_in *) SDL_calloc(1, sizeof (*addr));
+    if (!ai || !addr) {
+        SDL_free(ai);
+        SDL_free(addr);
+        return NULL;
+    }
+    SDL_copyp(addr, sin);
+    addr->sin_len = sizeof (*addr);
+    addr->sin_family = AF_INET;
+    ai->ai_family = AF_INET;
+    ai->ai_socktype = socktype;
+    ai->ai_protocol = protocol;
+    ai->ai_addrlen = sizeof (*addr);
+    ai->ai_addr = (struct sockaddr *) addr;
+    return ai;
+}
+
+static int getaddrinfo(const char *node, const char *service, const struct addrinfo *hints, struct addrinfo **res)
+{
+    int flags = 0;
+    int socktype = 0;
+    int protocol = 0;
+    int family = AF_INET;
+    Uint16 port = 0;
+
+    if (!res) {
+        return EAI_FAIL;
+    }
+    *res = NULL;
+
+    if (hints) {
+        flags = hints->ai_flags;
+        socktype = hints->ai_socktype;
+        protocol = hints->ai_protocol;
+        if (hints->ai_family != AF_UNSPEC && hints->ai_family != AF_INET) {
+            return EAI_FAMILY;
+        }
+        family = AF_INET;
+        (void) family;
+    }
+
+    if (service && service[0]) {
+        char *end = NULL;
+        const long parsed = SDL_strtol(service, &end, 10);
+        if (!end || *end != '\0' || parsed < 0 || parsed > 65535) {
+            return EAI_SERVICE;
+        }
+        port = (Uint16) parsed;
+    }
+
+    if (!socktype) {
+        socktype = SOCK_STREAM;
+    }
+    if (!protocol) {
+        protocol = (socktype == SOCK_DGRAM) ? IPPROTO_UDP : IPPROTO_TCP;
+    }
+
+    struct sockaddr_in sin;
+    SDL_zero(sin);
+    sin.sin_family = AF_INET;
+    sin.sin_port = htons(port);
 
+    if (!node || !node[0]) {
+        sin.sin_addr.s_addr = (flags & AI_PASSIVE) ? htonl(INADDR_ANY) : htonl(INADDR_LOOPBACK);
+        *res = PS3AllocAddrInfo(socktype, protocol, &sin);
+        return *res ? 0 : EAI_MEMORY;
+    }
+
+    if (inet_aton(node, &sin.sin_addr)) {
+        *res = PS3AllocAddrInfo(socktype, protocol, &sin);
+        return *res ? 0 : EAI_MEMORY;
+    }
+
+    if (flags & AI_NUMERICHOST) {
+        return EAI_NONAME;
+    }
+
+    struct hostent *he = gethostbyname(node);
+    if (!he || he->h_addrtype != AF_INET || !he->h_addr_list || !he->h_addr_list[0]) {
+        return EAI_NONAME;
+    }
+
+    struct addrinfo *head = NULL;
+    struct addrinfo *tail = NULL;
+    for (char **alist = he->h_addr_list; *alist; alist++) {
+        SDL_memcpy(&sin.sin_addr, *alist, sizeof (sin.sin_addr));
+        struct addrinfo *ai = PS3AllocAddrInfo(socktype, protocol, &sin);
+        if (!ai) {
+            freeaddrinfo(head);
+            return EAI_MEMORY;
+        }
+        if ((flags & AI_CANONNAME) && he->h_name && !head) {
+            ai->ai_canonname = SDL_strdup(he->h_name);
+        }
+        if (!head) {
+            head = ai;
+        } else {
+            tail->ai_next = ai;
+        }
+        tail = ai;
+    }
+    *res = head;
+    return head ? 0 : EAI_NONAME;
+}
