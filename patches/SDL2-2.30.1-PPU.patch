diff -Nru SDL2-2.30.1/src/video/psl1ght/SDL_PSL1GHTmodes.c SDL2-2.30.1/src/video/psl1ght/SDL_PSL1GHTmodes.c
--- SDL2-2.30.1/src/video/psl1ght/SDL_PSL1GHTmodes.c	1969-12-31 21:00:00
+++ SDL2-2.30.1/src/video/psl1ght/SDL_PSL1GHTmodes.c	2026-09-05 18:29:55
@@ -0,0 +1,183 @@
