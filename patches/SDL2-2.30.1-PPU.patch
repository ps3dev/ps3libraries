+{
+}
+void
+PSL1GHT_RaiseWindow(_THIS, SDL_Window * window)
+{
+}
+void
+PSL1GHT_MaximizeWindow(_THIS, SDL_Window * window)
+{
+}
+void
+PSL1GHT_MinimizeWindow(_THIS, SDL_Window * window)
