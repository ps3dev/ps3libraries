new file mode 100644
index 000000000..21a2b7201
--- /dev/null
+++ b/src/joystick/ps3/SDL_sysjoystick.c
@@ -0,0 +1,283 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
